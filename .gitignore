# ====================== 前端 Vite / Vue3 忽略规则（已合并 LightVueAdmin/.gitignore）======================
# 依赖包
node_modules/

# 包管理器锁文件（可选提交；当前项目未提交，规则保留）
package-lock.json
yarn.lock
pnpm-lock.yaml

# Vite 编译产物
dist/
dist-ssr/
*.local

# 环境变量（含密钥、接口地址，一律不提交）
.env
.env.local
.env.*.local

# 前端日志
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 本地启动 / 重置脚本（不含密钥，但仅本地使用）
dev-all.js
reset-demo.bat
dev-all.bat
Scripts/

# 暂时不需的文档
WRITEME.md
ProjectAnalysis.md
BackendBusinessSummary.md

# ====================== .NET C# 后端 忽略规则 ======================
# .NET 编译输出目录
bin/
obj/

# Visual Studio 缓存 &amp; 用户配置（因人而异，不提交）
.vs/
*.user
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.tmp

# ★★★ ASP.NET Core 配置文件（含 JWT 密钥 / 数据库密码，禁止提交）★★★
**/appsettings.json
**/appsettings.Development.json
**/appsettings.Staging.json
**/appsettings.Production.json
# 保留模板文件，供团队成员参考（! 表示反向规则，不忽略）
!**/appsettings.json.example
!**/appsettings.json.template

# 本地启动配置（端口 / 浏览器启动行为因人而异）
**/Properties/launchSettings.json

# 后端发布文件夹
publish/

# 后端日志文件
*.log

# ====================== 证书 / 私钥 / 机密文件兜底 ======================
*.pem
*.key
*.crt
*.pfx
*.cer
secrets.json

# ====================== 通用：编辑器 / 系统 / 临时文件 ======================
# VS Code 工作区配置
.vscode/

# 其他编辑器临时文件
*.swp
*.swo
.idea/

# Windows / Mac 系统文件
Thumbs.db
.DS_Store

# 全局临时目录
tmp/
temp/
